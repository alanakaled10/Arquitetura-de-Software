flowchart TD
    Inicio(( )) --> A[Recebe produto e quantidade]
    A --> B{Produto descontinuado?}
    B -- [sim] --> R1[Recusa: produto descontinuado]
    B -- [não] --> C{Tem estoque disponível?}
    C -- [não] --> R2[Recusa: sem estoque disponível]
    C -- [sim] --> D{Quantidade maior que o estoque?}
    D -- [sim] --> R3[Recusa: estoque insuficiente]
    D -- [não] --> E[Baixa a quantidade do estoque]
    E --> F{Estoque zerou?}
    F -- [sim] --> G[Muda status para INDISPONÍVEL]
    F -- [não] --> H[Salva produto]
    G --> H
    H --> I[Confirma saída]
    I --> Fim(( ))
    R1 --> Fim
    R2 --> Fim
    R3 --> Fim
